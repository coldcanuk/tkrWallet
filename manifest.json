{
  "manifest_version": 3,
  "name": "tkrWallet",
  "version": "0.10.4",
  "description": "Self-custody wallet for Scratchpost. You hold the keys.",
  "action": {
    "default_popup": "index.html",
    "default_title": "tkrWallet",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://tkrwallet.scratchpost.ai/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://tkrwallet.scratchpost.ai; img-src 'self' data:; style-src 'self'"
  },
  "key": ""
}
