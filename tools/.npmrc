; NOTE: npm refuses to honour `cache` from a project-level .npmrc (it is one of
; the keys restricted to user/global config). Set it on the command line instead:
;   npm --prefix tools install --cache tools/.npm-cache
; That is what the repo-root `npm run setup` script does, for environments with
; a read-only $HOME (sandboxes, some CI images).
fund=false
audit=false
