{
  "name": "tkrwallet-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Build-only tooling for tkrWallet. Never shipped to the browser.",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/app.css -o ../app.css --minify",
    "watch:css": "tailwindcss -i ./src/app.css -o ../app.css --watch"
  }
}
