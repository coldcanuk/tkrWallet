{
  "name": "tkrwallet",
  "version": "0.4.0",
  "private": true,
  "description": "Self-custody wallet for Scratchpost. PWA + MV3 Chrome extension, one tree.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/coldcanuk/tkrWallet.git"
  },
  "scripts": {
    "setup": "npm --prefix tools install --cache tools/.npm-cache",
    "test": "node app_test.js",
    "build:css": "npm --prefix tools run build:css",
    "watch:css": "npm --prefix tools run watch:css",
    "check:css": "npm run build:css && git diff --exit-code -- app.css"
  },
  "engines": {
    "node": ">=20"
  }
}
