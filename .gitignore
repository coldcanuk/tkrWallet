# ── Linked git worktrees (this repo uses `git worktree add .worktrees/<name>`) ──
.worktrees/

# ── Dependencies ────────────────────────────────────────────────────────────
# Build tooling only. Never appears next to manifest.json: the extension is
# loaded unpacked from the repo root, so node_modules would be packaged with it.
node_modules/
tools/.npm-cache

# ── Secrets (never commit; pass-managed) ────────────────────────────────────
.env
.env.*
!.env.example
# CRX signing key (private half). The public key lives in manifest.json.
key.pem
*.crx
.extension-id

# ── Licensed Tailwind Plus reference kits (https://tailwindcss.com/plus/license)
#
# Purchased commercial products. tkrWallet is GPLv3 + public, so the kits must
# stay OUT of the repo: using their components to build this wallet is
# permitted, but committing a copy of the kit is repackaging. Keep them on disk
# as local reference material. See docs/specs/tailwind-plus-usage.md.
application-ui-v4/
catalyst-ui-kit/

# ── Live GitHub Actions runner (on-disk only; never pack into the PWA) ──
# Contains .credentials. Leave the runner where it is; do not git add it.
actions-runner/

# ── Local RDAP-Q session state ─────────────────────────────────────────────
.rdapq/

# ── Local tooling ───────────────────────────────────────────────────────────
# Headless-Chromium screenshots and probe scripts (Playwright).
.ui-shots/

# ── Editor / OS noise ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.log
npm-debug.log*
